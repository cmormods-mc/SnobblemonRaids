  "contact": {
    "homepage": "https://github.com/cmormods-mc/SnobblemonRaids",
    "sources": "https://github.com/cmormods-mc/SnobblemonRaids",
    "issues": "https://github.com/cmormods-mc/SnobblemonRaids/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.cobbleraids.CobbleRaids"],
    "client": ["com.cobbleraids.client.CobbleRaidsClient"]
  },
  "mixins": ["mixins/cobbleraids.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": ">=0.116.6+1.21.1",
    "minecraft": "1.21.1",
    "java": ">=21",
    "cobblemon": "1.7.3"
  },
  "recommends": {
    "skiesguis": "1.8.1"
  },
